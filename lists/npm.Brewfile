# @Name: npm globals
# @Description: Global npm packages (needs node and npm on PATH)

# --- Development ---

# --- Test Runners, utils and debuggers ---
# Mocha is a feature-rich JavaScript test framework running on Node.js and in the browser https://mochajs.org/
npm "mocha"
# 🚀 Futuristic JavaScript test runner https://github.com/avajs/ava
npm "ava"

# --- Build and Task Runners/Package managers ---
# The Grunt command line interface https://github.com/gruntjs/grunt-cli
npm "grunt-cli"
# Command Line Utility for Gulp https://github.com/gulpjs/gulp-cli
npm "gulp-cli"
# webpack is a module bundler. Its main purpose is to bundle JavaScript files for usage in a browser, yet it is also capable of transforming, bundling, or packaging
npm "webpack"
# A tool for managing JavaScript projects with multiple packages https://lernajs.io/
npm "lerna"

# --- Code Quality (linters, style checkers, etc.) ---
# ESLint is a tool for identifying and reporting on patterns found in ECMAScript/JavaScript code https://github.com/eslint/eslint
npm "eslint"

# --- Networks ---
# A live secure tunnel redirect public requests to your own local server befind a NAT or firewall https://github.com/localtunnel/localtunnel
npm "localtunnel"
# Vercel CLI (formerly now): deploy Node apps, Dockerfiles and static sites https://vercel.com/docs/cli
npm "vercel"

# --- Development Productivity ---
# Find Out When Your Dependencies are Outdated https://david-dm.org/
npm "david"
# Tool to summarise all code annotation like TODO or FIXME https://github.com/ahmadassaf/code-notes
npm "code-notes"
# A git log to CHANGELOG.md tool https://github.com/nodejs/changelog-maker
npm "changelog-maker"
# Replacement for `npm version` with automatic CHANGELOG generation https://github.com/conventional-changelog/standard-version
npm "standard-version"
# semantic-release automates the whole package release workflow https://github.com/semantic-release/semantic-release
npm "semantic-release-cli"
# The commitizen command line utility https://github.com/commitizen/cz-cli
npm "commitizen"
# cz-conventional-changelog is a plugin that describes the desired commit format https://github.com/commitizen/cz-conventional-changelog
npm "cz-conventional-changelog"

# --- Git Plugins ---
# A tool to list print the commits on one git branch that are not on another using loose comparison https://github.com/nodejs/branch-diff
npm "branch-diff"
# If you just ran a git command that you didn't mean to, this program will either undo it, tell you how to undo it, or tell you it's impossible to undo https://github.com/mapmeld/gitjk
npm "gitjk"

# --- Data Processing ---
# A command-line tool for processing data with functional pipelines https://github.com/raine/ramda-cli
npm "ramda-cli"
# Formatting JSON data in a coloured YAML-style, perfect for CLI output https://github.com/rafeca/prettyjson
npm "prettyjson"

# --- System ---
# Advanced process manager for production Node.js applications http://pm2.keymetrics.io/
npm "pm2"
# Clinic diagnoses your Node.js performance issues https://github.com/nearform/node-clinic
npm "clinic"
# Automate Restarting Node.js Applications https://nodemon.io/
npm "nodemon"
# A graphical activity monitor for the command line https://github.com/MrRio/vtop
npm "vtop"
