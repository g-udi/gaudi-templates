# @Name: Core tools
# @Description: Command-line tools and libraries installed with Homebrew

tap "koekeishiya/formulae"

# --- Core Modules ---
# GNU File, Shell, and Text utilities
brew "coreutils"
# GNU grep, egrep and fgrep
brew "grep"
# Search tool like grep, but optimized for programmers https://beyondgrep.com/
brew "ack"
# GNU awk utility
brew "gawk"
# GNU implementation of the famous stream editor
brew "gnu-sed"
# Collection of GNU find, xargs, and locate https://www.gnu.org/software/findutils/
brew "findutils"
# Internet file retriever
brew "wget"
# Bourne-Again SHell, a UNIX command interpreter
brew "bash"
# UNIX shell (command interpreter)
brew "zsh"
# Distributed version control system designed to handle everything from small to very large projects with speed and efficiency
brew "git"
# Cross-platform C++ GUI toolkit (wxWidgets for macOS)
brew "wxwidgets"
# C XSLT library for GNOME
brew "libxslt"
# Library for command-line editing
brew "readline"
# Portable Foreign Function Interface library
brew "libffi"
# ⚡ preexec and precmd functions for Bash just like Zsh https://github.com/rcaloras/bash-preexec
brew "bash-preexec"
# GNU libtool is a generic library support script. Libtool hides the complexity of using shared libraries behind a consistent, portable interface
brew "libtool"
# ODBC 3 connectivity for UNIX
brew "unixodbc"
# Boost provides free peer-reviewed portable C++ source libraries https://www.boost.org/
brew "boost"
# A C library for parsing and emitting YAML https://github.com/yaml/libyaml
brew "libyaml"
# GnuPG is a complete and free implementation of the OpenPGP standard https://www.gnupg.org/
brew "gnupg"

# --- Development ---
# Extendable version manager with support for Ruby, Node.js, Elixir, Erlang & more https://github.com/asdf-vm/asdf
brew "asdf"
# Static analysis and lint tool, for bash scripts https://www.shellcheck.net/
brew "shellcheck"
# JavaScript package manager https://yarnpkg.com/en/
brew "yarn"
# Compose is a tool for defining and running multi-container Docker applications https://docs.docker.com/compose/
brew "docker-compose"
# Ctags generates an index (or tag) file of language objects found in source files that allows these items to be quickly and easily located by a text editor or other utility http://ctags.sourceforge.net/
brew "ctags"
# Minikube is a tool that makes it easy to run Kubernetes locally https://github.com/kubernetes/minikube
brew "minikube"

# --- Git speific addons ---
# GIT utilities -- repo summary, repl, changelog population, author commit percentages and more https://github.com/tj/git-extras
brew "git-extras"
# git-crypt enables transparent encryption and decryption of files in a git repository https://www.agwa.name/projects/git-crypt/
brew "git-crypt"
# Keep your Git repo fresh https://github.com/imsky/git-fresh
brew "git-fresh"
# Compute various size metrics for a Git repository, flagging those that might cause problems https://github.com/github/git-sizer
brew "git-sizer"
# Generic, high-level Git workflow support https://github.com/Originate/git-town
brew "git-town"
# Git extension for versioning large files https://github.com/git-lfs/git-lfs
brew "git-lfs"
# Text interface for Git repositories https://jonas.github.io/tig/
brew "tig"
# Remove large files or passwords from Git history like git-filter-branch https://rtyley.github.io/bfg-repo-cleaner/
brew "bfg"
# github like contributions calendar on terminal https://github.com/k4rthik/git-cal
brew "git-cal"
# Easy creation of secure SSH configuration for your GitHub accounts https://github.com/dolmen/github-keygen
brew "github-keygen"
# Easy TOC creation for GitHub README.md https://github.com/ekalinin/github-markdown-toc.go
brew "github-markdown-toc"
# Commandline app to create and edit releases on Github and upload artifacts https://github.com/aktau/github-release
brew "github-release"
# hub is a command-line wrapper for git that makes you better at GitHub https://hub.github.com/
brew "hub"

# --- Utilities ---
# Terminal multiplexer https://tmux.github.io/
brew "tmux"
# Clipper is a macOS launch agent — or Linux daemon — that runs in the background providing a service that exposes the local clipboard to tmux sessions and other processes running both locally and remotely https://github.com/wincent/clipper
brew "clipper"
# A modern and intuitive terminal-based text editor https://micro-editor.github.io
brew "micro"
# Terminal multiplexer with VT100/ANSI terminal emulation
brew "screen"
# Tool for generating GNU Standards-compliant Makefiles https://www.gnu.org/software/automake/
brew "automake"
# Programmable completion for Bash 4.1+ https://github.com/scop/bash-completion
brew "bash-completion@2"
# FSF/GNU ld, ar, readelf, etc. for native development
brew "binutils"
# Collection of tools that nobody wrote when UNIX was young https://joeyh.name/code/moreutils/
brew "moreutils"
# Control Google Chrome from the command-line https://github.com/prasmussen/chrome-cli
brew "chrome-cli"
# GNU Emacs text editor https://www.gnu.org/software/emacs/
brew "emacs"
# Colorize logfiles and command output https://github.com/garabik/grc
brew "grc"
# Lightweight and flexible command-line JSON processor https://stedolan.github.io/jq/
brew "jq"
# Magnificent app which corrects your previous console command https://github.com/nvbn/thefuck
brew "thefuck"
# Display directories as trees with optional color/HTML output http://mama.indstate.edu/users/ice/tree/
brew "tree"
# Awesome tmux-based terminal divider https://github.com/greymd/tmux-xpanes
brew "tmux-xpanes"
# A collection of small bash scripts for heavy terminal users https://github.com/alexanderepstein/Bash-Snippets
brew "bash-snippets"
# PathPicker accepts a wide range of input -- output from git commands, grep results, searches https://facebook.github.io/PathPicker/
brew "fpp"
# Bash and Zsh shell history suggest box - easily view, navigate, search and manage your command history https://github.com/dvorka/hstr
brew "hstr"
# Tools and libraries to manipulate images in many formats https://www.imagemagick.org/script/index.php
brew "imagemagick"
#  Swiss Army Knife for macOS https://github.com/rgcr/m-cli
brew "m-cli"
# Keep your application settings in sync https://github.com/lra/mackup
brew "mackup"
# Vim - the text editor - for Mac OS X http://macvim-dev.github.io/macvim
brew "macvim"
# 📦 Mac App Store command line interface https://github.com/mas-cli/mas
brew "mas"
# Port scanning utility for large networks https://nmap.org/
brew "nmap"
# A code-searching tool similar to ack, but faster https://github.com/ggreer/the_silver_searcher
brew "the_silver_searcher"
# QR Code generation https://fukuchi.org/works/qrencode/index.html.en
brew "qrencode"
# Watchman exists to watch files and record when they change https://facebook.github.io/watchman/
brew "watchman"
# A command-line fuzzy finder https://github.com/junegunn/fzf
brew "fzf"
# Simplistic interactive filtering tool https://github.com/peco/peco
brew "peco"
# Launch calc and you can start typing equations https://github.com/lcn2/calc
brew "calc"
# A tiling window manager for macOS based on binary space partitioning https://github.com/koekeishiya/yabai
brew "koekeishiya/formulae/yabai"
# Simple hotkey daemon for macOS https://github.com/koekeishiya/skhd
brew "koekeishiya/formulae/skhd"

# --- Network ---
# A reverse proxy / load balancer that's easy, dynamic, automatic, fast, full-featured, open source, production proven, provides metrics, and integrates with every major cluster technologies https://traefik.io/
brew "traefik"
# IRC built-in. Multi-protocol friendly for module authors https://irssi.org/
brew "irssi"
# HTTPie—aitch-tee-tee-pie—is a command line HTTP client with an intuitive UI, JSON support, syntax highlighting, wget-like downloads, plugins, and more https://httpie.org/
brew "httpie"
