# @Name: Python tools
# @Description: Python command-line tools, isolated with uv instead of pip --user

brew "uv"

# Official Amazon AWS command-line interface https://docs.aws.amazon.com/cli
brew "awscli"
# Glances is a cross-platform system monitoring tool written in Python https://nicolargo.github.io/glances/
brew "glances"
# Pylint is a source code, bug and quality checker for the Python programming language https://www.pylint.org/
uv "pylint"
